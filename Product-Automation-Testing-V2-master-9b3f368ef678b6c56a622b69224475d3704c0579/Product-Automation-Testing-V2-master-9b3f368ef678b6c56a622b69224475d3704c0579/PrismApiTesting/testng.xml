  <test thread-count="20" parallel="methods" name="Test" verbose="3">
    <classes>
      <class name="test.Activity">
        <methods>
          <include name="ActivityPageDeleteInteraction"/>
          <include name="verifyActivityTileData"/>
          <include name="ActivityPageWithContactTearSheet"/>
          <include name="ActivityPageEditInteractionVerifyHistory"/>
          <include name="ActivityPageWithAccTearSheet"/>
          <include name="ActivityPageShowAndHide"/>
          <include name="checkColumnSorting"/>
          <include name="ActivityPageShowAndHideIncludeandExcludeFilterWithMultiFilterSearch"/>
          <include name="ActivityPageShowAndHideExcludeFilterWithSingleFilterSearch"/>
          <include name="ActivityPageShowAndHideExcludeRandomFilter"/>
          <include name="ActivityPageShowAndHideIncludeFilterWithSingleFilterSearch"/>
        </methods>
      </class> <!-- test.Activity -->
      <class name="test.Readership">
        <methods>
          <include name="ReadershipPageWithContactTearSheet"/>
        </methods>
      </class> <!-- test.Readership -->
      <class name="test.TickerTearSheet">
        <methods>
