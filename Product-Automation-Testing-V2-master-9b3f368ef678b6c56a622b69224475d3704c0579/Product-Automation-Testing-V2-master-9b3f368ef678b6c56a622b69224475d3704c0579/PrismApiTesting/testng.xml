          <include name="TickerTearSheetActivityTabShowAndHideSingleExcludeFilterSearch"/>
        </methods>
      </class> <!-- test.TickerTearSheet -->
      <class name="test.AccountTearSheet">
        <methods>
          <include name="AccountTearSheetActivityTabShowAndHideSingleExcludeFilterSearch"/>
          <include name="AccountTearSheetActivityTabShowAndHideSingleIncludeFilterSearch"/>
          <include name="AccountTearSheetActivityTabShowAndHideMultiFilterSearch"/>
        </methods>
      </class> <!-- test.AccountTearSheet -->
      <class name="test.ContactTearSheet">
        <methods>
          <include name="ContactTearSheetActivityTabShowAndHideMultiFilterSearch"/>
          <include name="ContactTearSheetActivityTabShowAndHideSingleExcludeFilterSearch"/>
          <include name="ContactTearSheetActivityTabShowAndHideSingleIncludeFilterSearch"/>
        </methods>
      </class> <!-- test.ContactTearSheet -->
      <class name="test.MyList">
        <methods>
          <include name="MyListDynamicListWithContactTearSheet"/>
          <include name="MyListStaticListWithContactTearSheet"/>
        </methods>
      </class> <!-- test.MyList -->
    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->
